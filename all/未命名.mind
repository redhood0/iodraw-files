{"root":{"data":{"id":"dm9fkoiosjk0","created":1792475612545,"text":"S3航海主题"},"children":[{"data":{"id":"dm9fktk6wc00","created":1792475623520,"text":"主题关键字","layout":null},"children":[{"data":{"id":"dm9fqbubvu80","created":1792476055136,"text":"航行","layout":null},"children":[]},{"data":{"id":"dm9fqceyads0","created":1792476056383,"text":"深海探宝","layout":null},"children":[]},{"data":{"id":"dm9fqcyj2rs0","created":1792476057567,"text":"洋流","layout":null},"children":[]},{"data":{"id":"dm9fqowtbuw0","created":1792476083584,"text":"礁石","layout":null},"children":[]},{"data":{"id":"dm9fqsihtps0","created":1792476091425,"text":"商贸","layout":null},"children":[]}]},{"data":{"id":"dm9fkugyrf40","created":1792475625502,"text":"设计方向","layout":null},"children":[{"data":{"id":"dm9fvnsifa80","created":1792476472968,"text":"基础可用性","layout":null},"children":[{"data":{"id":"dm9fvrgt4j40","created":1792476480968,"text":"信息补充类","layout":null},"children":[]},{"data":{"id":"dm9fvsp4sns0","created":1792476483648,"text":"挂机收益类","layout":null},"children":[]},{"data":{"id":"dm9fvtc2cy00","created":1792476485034,"text":"特殊机制","layout":null},"children":[{"data":{"id":"dm9fw8bo1g00","created":1792476517662,"text":"偷","layout":null},"children":[]},{"data":{"id":"dm9fw8ubtyw0","created":1792476518790,"text":"复制","layout":null},"children":[]},{"data":{"id":"dm9fwchmzps0","created":1792476526730,"text":"劫掠船只","layout":null},"children":[]}]}]},{"data":{"id":"dm9fwmpc6740","created":1792476548964,"text":"包装趣味性","layout":null},"children":[{"data":{"id":"dm9fwwwmnfk0","created":1792476571172,"text":"寻宝机制","layout":null},"children":[]}]},{"data":{"id":"dm9fx1tpb9k0","created":1792476581879,"text":"差异性","layout":null},"children":[{"data":{"id":"dm9fy1czk5k0","created":1792476659233,"text":"和S1、S2的房车有一定差异化","layout":null},"children":[]}]}]},{"data":{"id":"dm9fkwfo0i00","created":1792475629777,"text":"玩法概述","layout":null},"children":[{"data":{"id":"dm9g9wzagog0","created":1792477590067,"text":"玩家可以派遣游艇（玩家皮肤）在地图中移动，获取信息或其他收益","layout":null},"children":[]},{"data":{"id":"dm9ga79xjog0","created":1792477612479,"text":"游艇可以装载不同类型航海芯片","layout":null},"children":[]},{"data":{"id":"dm9gaii9wlc0","created":1792477636928,"text":"派遣方式：参考s1赛车，玩家给定行驶方向，首次派遣会根据方向移动，后续每回合开始会自动驾驶（有可能偏航）","layout":null},"children":[]}]},{"data":{"id":"dm9fr4p2fts0","created":1792476117944,"text":"航海芯片","layout":null},"children":[{"data":{"id":"dm9g01sqllk0","created":1792476816913,"text":"科研芯片","layout":null},"children":[{"data":{"id":"dm9g0aejmhc0","created":1792476835646,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g0ql46000","created":1792476870872,"text":"分支主题","layout":null},"children":[]}]},{"data":{"id":"dm9g0ch10fc0","created":1792476840150,"text":"低航速","layout":null},"children":[{"data":{"id":"dm9g0fa44ns0","created":1792476846262,"text":"3格每回合","layout":null},"children":[]}]}]},{"data":{"id":"dm9g039vqgw0","created":1792476820127,"text":"快艇芯片","layout":null},"children":[{"data":{"id":"dm9g0vnf9d40","created":1792476881895,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g0xy8ztk0","created":1792476886904,"text":"无机质白板","layout":null},"children":[]}]},{"data":{"id":"dm9g13kn5rc0","created":1792476899142,"text":"极高航速","layout":null},"children":[{"data":{"id":"dm9g16qlq3k0","created":1792476906032,"text":"8格每回合","layout":null},"children":[]}]}]},{"data":{"id":"dm9g03tgddc0","created":1792476821310,"text":"捕鱼芯片","layout":null},"children":[{"data":{"id":"dm9g1e7p9q00","created":1792476922304,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g1g5x9gw0","created":1792476926550,"text":"每回合结束挂机收益","layout":null},"children":[]}]},{"data":{"id":"dm9g1k5divc0","created":1792476935224,"text":"低航速","layout":null},"children":[{"data":{"id":"dm9g1mvivl40","created":1792476941158,"text":"4格每回合","layout":null},"children":[]}]}]},{"data":{"id":"dm9g04hkj8w0","created":1792476822768,"text":"海盗芯片","layout":null},"children":[{"data":{"id":"dm9g1pytwu00","created":1792476947889,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g43mvf0w0","created":1792477134369,"text":"回合结束X%概率偷取藏品","layout":null},"children":[]},{"data":{"id":"dm9g44e97ds0","created":1792477136025,"text":"搁浅碰到的平民船只，获得收益","layout":null},"children":[]}]},{"data":{"id":"dm9g1stqoq00","created":1792476954111,"text":"中航速","layout":null},"children":[{"data":{"id":"dm9g65afops0","created":1792477294699,"text":"5格每回合","layout":null},"children":[]}]}]},{"data":{"id":"dm9g0552nlk0","created":1792476824190,"text":"大货轮芯片","layout":null},"children":[{"data":{"id":"dm9g602ndyo0","created":1792477283344,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g80ph7hs0","created":1792477441453,"text":"收取沿途体积≥5的藏品","layout":null},"children":[{"data":{"id":"dm9g8f2xhow0","created":1792477472741,"text":"哈兰德专属配合","layout":null},"children":[]}]},{"data":{"id":"dm9g8j50few0","created":1792477481574,"text":"获得沿途所有白、绿、蓝藏品","layout":null},"children":[{"data":{"id":"dm9g8unhjdc0","created":1792477506636,"text":"捡垃圾船，低价值跑刀","layout":null},"children":[]}]},{"data":{"id":"dm9g93xraxs0","created":1792477526848,"text":"回合结束有x%概率复制1件藏品（归自己所有）","layout":null},"children":[{"data":{"id":"dm9g9lkfqoo0","created":1792477565225,"text":"特化复制","layout":null},"children":[]}]}]},{"data":{"id":"dm9g60v85iw0","created":1792477285072,"text":"低航速","layout":null},"children":[{"data":{"id":"dm9g6d69e3k0","created":1792477311861,"text":"3格每回合","layout":null},"children":[]}]}]},{"data":{"id":"dm9g05nmgpc0","created":1792476825311,"text":"军舰芯片","layout":null},"children":[{"data":{"id":"dm9g6xdw8rc0","created":1792477355858,"text":"机制","layout":null},"children":[{"data":{"id":"dm9g719ky2g0","created":1792477364304,"text":"击沉碰撞的海盗船，获得收益","layout":null},"children":[]}]},{"data":{"id":"dm9g6y3s74w0","created":1792477357423,"text":"中高航速","layout":null},"children":[{"data":{"id":"dm9g7doudxs0","created":1792477391348,"text":"6格每回合","layout":null},"children":[]}]}]}]},{"data":{"id":"dm9ga53vxgw0","created":1792477607759,"text":"宝藏标记","layout":null},"children":[{"data":{"id":"dm9gaqk1vi00","created":1792477654449,"text":"出现规则","layout":null},"children":[{"data":{"id":"dm9gaurcpls0","created":1792477663598,"text":"S3赛季地图中会出现的特殊标记，每局随机出现1~2个，通常出现在地图的底部","layout":null},"children":[]},{"data":{"id":"dm9gdkxgcq00","created":1792477877292,"text":"不影响基础地图掉率，属于S3额外机制，可以判断是否有玩家携带船只来决定是否触发（没人带船就没必要显示）","layout":null},"children":[]}]},{"data":{"id":"dm9gat7mceg0","created":1792477660228,"text":"宝藏获取","layout":null},"children":[{"data":{"id":"dm9gej9saww0","created":1792477952048,"text":"第一个到达宝藏的玩家，在结算时可以获得宝藏","layout":null},"children":[]},{"data":{"id":"dm9geuzub3k0","created":1792477977568,"text":"如果没有任何人抵达宝藏，则竞拍成功宝藏会消失","layout":null},"children":[]}]},{"data":{"id":"dm9gatsasjs0","created":1792477661478,"text":"宝藏内容","expandState":"expand","layout":null},"children":[{"data":{"id":"dm9gfuwxfio0","created":1792478055756,"text":"宝藏的本质是玩家用航线的油耗（金币）换取一次赌博红色的机会（抽奖券），因此宝藏的平均价值等于玩家平均油耗我觉得是合理范围，需要把偏航概率考虑进去","layout":null},"children":[]},{"data":{"id":"dm9gge25hwg0","created":1792478097431,"text":"宝藏内容","layout":null},"children":[{"data":{"id":"dm9gh7dndxk0","created":1792478161253,"text":"随机红藏品箱","layout":null},"children":[]},{"data":{"id":"dm9ghb4c3z40","created":1792478169396,"text":"顶级大红","layout":null},"children":[{"data":{"id":"dm9ghece4v40","created":1792478176414,"text":"非洲之心这类，概率可以配很低很低，但需要少量投放给玩家追梦（等于体彩的500w）","layout":null},"children":[]}]},{"data":{"id":"dm9gi3uyuw00","created":1792478231957,"text":"填充","layout":null},"children":[{"data":{"id":"dm9gibxt4c00","created":1792478249543,"text":"小红","layout":null},"children":[{"data":{"id":"dm9gigz7vjc0","created":1792478260512,"text":"填充以稀释整体价值","layout":null},"children":[]}]},{"data":{"id":"dm9gicll85s0","created":1792478250981,"text":"大黄","layout":null},"children":[{"data":{"id":"dm9gigz7vjc0","created":1792478260512,"text":"填充以稀释整体价值","layout":null},"children":[]}]}]}]},{"data":{"id":"dm9girwqoeg0","created":1792478284307,"text":"包装角度","layout":null},"children":[{"data":{"id":"dm9giuiqd1s0","created":1792478289990,"text":"最好是沉船里能出现的","layout":null},"children":[]}]}]}]},{"data":{"id":"dm9gjuo2wu00","created":1792478368678,"text":"暗礁（非必须）"},"children":[{"data":{"id":"dm9gjxmluxc0","created":1792478375119,"text":"玩法规则"},"children":[{"data":{"id":"dm9gk5mez2w0","created":1792478392521,"text":"地图上会随机生成暗礁（参考扫雷）"},"children":[]},{"data":{"id":"dm9gkbxvrz40","created":1792478406276,"text":"藏品信息揭露或船只附近的暗礁会显露"},"children":[{"data":{"id":"dm9gknsjqa80","created":1792478432074,"text":"变成明雷"},"children":[]}]},{"data":{"id":"dm9gkrzu9s80","created":1792478441222,"text":"玩家船只触碰暗礁后会抛锚1回合"},"children":[]},{"data":{"id":"dm9gl0t1fx40","created":1792478460402,"text":"已经触发的暗礁会显示位置"},"children":[{"data":{"id":"dm9gl6rh6d40","created":1792478473368,"text":"其他玩家排雷"},"children":[]}]},{"data":{"id":"dm9gl9y48ig0","created":1792478480300,"text":"对玩家操控性有要求，自走棋船只不需要暗礁系统"},"children":[]}]}]},{"data":{"id":"dm9gly1fok00","created":1792478532744,"text":"扩展内容"},"children":[{"data":{"id":"dm9gm0cmhco0","created":1792478537774,"text":"S3限定局内道具"},"children":[{"data":{"id":"dm9gm8yfa4o0","created":1792478556506,"text":"藏宝图"},"children":[{"data":{"id":"dm9gmg4ngjs0","created":1792478572120,"text":"效果：使用后地图上显示1个只有你知道的宝藏地点"},"children":[]},{"data":{"id":"dm9gmirkfyo0","created":1792478577860,"text":"扩展场景：寻宝玩法有一定追求才考虑扩展对应道具"},"children":[]},{"data":{"id":"dm9gmu7g1gg0","created":1792478602764,"text":"玩法原型：三角中刷卡"},"children":[]}]}]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}