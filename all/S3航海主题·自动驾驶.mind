en":[]}]},{"data":{"id":"dm9g6y3s74w0","created":1792477357423,"text":"中高航速","layout":null},"children":[]}]}]},{"data":{"id":"dmadl6ckrog0","created":1792571569094,"text":"事件","expandState":"expand"},"children":[{"data":{"id":"dm9ga53vxgw0","created":1792477607759,"text":"宝藏标记","layout":null},"children":[{"data":{"id":"dm9gaqk1vi00","created":1792477654449,"text":"出现规则","layout":null},"children":[{"data":{"id":"dm9gaurcpls0","created":1792477663598,"text":"S3赛季地图中会出现的特殊标记，每局随机出现0~2个，通常出现在地图的底部","layout":null},"children":[]},{"data":{"id":"dm9gdkxgcq00","created":1792477877292,"text":"不影响基础地图掉率，属于S3额外机制，可以判断是否有玩家携带船只来决定是否触发（没人带船就没必要显示）","layout":null},"children":[]},{"data":{"id":"dmaz81qyezc0","created":1792632604764,"text":"宝藏标记只会出现在当前仓库底部（空位）"},"children":[]}]},{"data":{"id":"dm9gat7mceg0","created":1792477660228,"text":"宝藏获取","layout":null},"children":[{"data":{"id":"dm9gej9saww0","created":1792477952048,"text":"第一个到达宝藏的玩家，在结算时可以获得宝藏","layout":null},"children":[]},{"data":{"id":"dm9geuzub3k0","created":1792477977568,"text":"如果没有任何人抵达宝藏，则竞拍成功宝藏会消失","layout":null},"children":[{"data":{"id":"dmaz9v6tqlc0","created":1792632747214,"text":"不揭示秘宝"},"children":[]}]}]},{"data":{"id":"dm9gatsasjs0","created":1792477661478,"text":"宝藏内容","expandState":"expand","layout":null},"children":[{"data":{"id":"dm9gge25hwg0","created":1792478097431,"text":"宝藏内容","layout":null},"children":[{"data":{"id":"dm9gh7dndxk0","created":1792478161253,"text":"随机红藏品箱","layout":null},"children":[]},{"data":{"id":"dm9ghb4c3z40","created":1792478169396,"text":"顶级大红","layout":null},"children":[{"data":{"id":"dm9ghece4v40","created":1792478176414,"text":"非洲之心这类，概率可以配很低很低，但需要少量投放给玩家追梦（等于体彩的500w）","layout":null},"children":[]}]},{"data":{"id":"dm9gi3uyuw00","created":1792478231957,"text":"填充","layout":null},"children":[{"data":{"id":"dm9gibxt4c00","created":1792478249543,"text":"小红","layout":null},"children":[{"data":{"id":"dm9gigz7vjc0","created":1792478260512,"text":"填充以稀释整体价值","layout":null},"children":[]}]},{"data":{"id":"dm9gicll85s0","created":1792478250981,"text":"大黄","layout":null},"children":[{"data":{"id":"dm9gigz7vjc0","created":1792478260512,"text":"填充以稀释整体价值","layout":null},"children":[]}]}]}]},{"data":{"id":"dm9girwqoeg0","created":1792478284307,"text":"包装角度","layout":null},"children":[{"data":{"id":"dm9giuiqd1s0","created":1792478289990,"text":"最好是沉船里能出现的","layout":null},"children":[]}]}]},{"data":{"id":"dm9gxhmi42g0","created":1792479437382,"text":"设计目的","layout":null},"children":[{"data":{"id":"dm9gfuwxfio0","created":1792478055756,"text":"宝藏的本质是玩家用航线的油耗（金币）换取一次赌博红色的机会（抽奖券），因此宝藏的平均价值等于玩家平均油耗我觉得是合理范围，需要把偏航概率考虑进去","layout":null},"children":[]},{"data":{"id":"dm9gxw9e3mo0","created":1792479469241,"text":"原本1局只能有一个拍得者，改为2个，区别只是1个看大仓，1个看宝藏（小仓），把原本单赢的局改成双赢"},"children":[]}]}]},{"data":{"id":"dmadlsbpzu00","created":1792571616932,"text":"特殊事件"},"children":[{"data":{"id":"dmazadtztgw0","created":1792632787797,"text":"正面事件"},"children":[]},{"data":{"id":"dmazaep1isg0","created":1792632789675,"text":"负面事件"},"children":[]},{"data":{"id":"dmazaka0wa80","created":1792632801827,"text":"分支主题"},"children":[]}]}]},{"data":{"id":"dmadn9kcwyo0","created":1792571732824,"text":"数值维度"},"children":[{"data":{"id":"dmadnclanuo0","created":1792571739411,"text":"回合油耗"},"children":[]},{"data":{"id":"dmadnfdpo800","created":1792571745483,"text":"油价"},"children":[]},{"data":{"id":"dmadnlp746g0","created":1792571759238,"text":"船只数值"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}